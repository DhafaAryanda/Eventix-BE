// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(USER)

  // Email verification
  isEmailVerified    Boolean   @default(false)
  emailVerifyToken   String?   @unique
  emailVerifyExpires DateTime?

  // Forgot password
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // Refresh token
  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  eventsCreated Event[]

  @@index([email])
  @@index([emailVerifyToken])
  @@index([resetPasswordToken])
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  venue       String
  city        String
  eventDate   DateTime
  saleOpenAt  DateTime // ← kapan war tiket dimulai
  saleCloseAt DateTime?
  bannerUrl   String? // ← opsional, bisa diisi manual
  status      EventStatus @default(DRAFT)
  createdBy   String // ← userId yang buat event

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]
  creator     User         @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([eventDate])
  @@index([city])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALE_OPEN
  SOLD_OUT
  COMPLETED
}

model TicketType {
  id          String  @id @default(uuid())
  eventId     String
  name        String // ← "VVIP", "VIP", "Festival"
  price       Int // ← dalam satuan Rupiah
  quota       Int // ← total stok
  maxPerUser  Int     @default(2)
  description String? // ← tambah, deskripsi benefit tiket
  sortOrder   Int     @default(0) // ← urutan tampil (VVIP=1, VIP=2, dst)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([eventId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  ticketTypeId     String
  quantity         Int
  totalAmount      Int
  status           OrderStatus @default(PENDING)
  reservationToken String?     @unique
  expiresAt        DateTime? //  ← batas waktu bayar
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  payment    Payment?

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  externalId String        @unique // ← ID dari Midtrans/Xendit
  amount     Int
  status     PaymentStatus @default(PENDING)
  paymentUrl String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}
