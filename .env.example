# Salin ke .env lalu isi. Jangan pernah commit .env.
#
# DEVELOPMENT LOKAL: nilai default di bawah cocok dengan compose.yaml (root).
# PRODUCTION (VPS ~/stacks/eventix-be/.env): DATABASE_URL & REDIS_URL dirakit
# otomatis oleh deploy/compose.yaml dari POSTGRES_PASSWORD & REDIS_PASSWORD,
# jadi cukup isi kedua password itu (hex/alfanumerik, tanpa karakter khusus URL).

NODE_ENV=development
# URL frontend: dipakai untuk link email (verifikasi/reset) & redirect pembayaran
APP_URL=http://localhost:3000
# Origin yang diizinkan CORS saat NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# --- Database & cache (development) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventix
REDIS_URL=redis://:redis@localhost:6379

# --- Database & cache (production, dipakai deploy/compose.yaml) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@eventix.com

# --- Payment (Xendit) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Object storage S3-compatible (Cloudflare R2) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL: URL publik bucket (r2.dev atau custom domain), TANPA slash akhir.
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=eventix
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev
